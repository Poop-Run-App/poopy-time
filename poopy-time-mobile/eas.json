{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://poopy-time-dev.up.railway.app"
      }
    },
    "preview": {
      "environment": "preview",
      "developmentClient": false,
      "distribution": "internal",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://poopy-time-dev.up.railway.app"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://poopy-time-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
