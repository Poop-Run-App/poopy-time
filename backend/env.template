# Copy to backend/.env and fill in. Never commit .env.

# --- Database ---
# Leave all DB settings blank to use local SQLite (backend/instance/app.db).
# USE_LOCAL_SQLITE=true            # force SQLite even if DATABASE_URL is set globally
DATABASE_URL=
# DB_USERNAME=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres

# --- Secrets ---
SECRET_KEY=
JWT_SECRET_KEY=
# JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# --- Environment ---
FLASK_ENV=development

# --- CORS (comma-separated; blank = allow all) ---
# CORS_ORIGINS=http://localhost:3000,https://poopytime.app
